{
  "version": "1.2.0",
  "platform": {
    "commissionRate": 0.20,
    "minimumFee": 10,
    "currency": "USD"
  },
  "contracts": {
    "claim-v1": {
      "orchestrator": "olang-kernel",
      "requiredCapabilities": ["read_claim", "fraud_check", "submit_claim", "flag_for_review"],
      "delegationRules": {
        "submit_claim": {
          "requiresPriorStep": ["fraud_check"],
          "denyIf": { "fraud": true }
        }
      },
      "outcomes": {
        "COMPLETED": ["read_claim", "fraud_check", "submit_claim"],
        "HELD_FOR_REVIEW": ["read_claim", "fraud_check", "flag_for_review"]
      },
      "billing": {
        "unit": "claim-delegated",
        "billableOutcomes": ["COMPLETED"],
        "commissionRate": 0.20
      }
    },
    "transcription-v1": {
      "orchestrator": "olang-kernel",
      "requiredCapabilities": ["transcribe_audio", "translate_text"],
      "outcomes": {
        "COMPLETED": ["transcribe_audio", "translate_text"]
      },
      "billing": {
        "unit": "minute-transcribed",
        "billableOutcomes": ["COMPLETED"],
        "commissionRate": 0.15
      }
    },
    "kyc-v1": {
      "orchestrator": "olang-kernel",
      "requiredCapabilities": ["verify_identity", "check_sanctions"],
      "outcomes": {
        "COMPLETED": ["verify_identity", "check_sanctions"],
        "REJECTED": ["verify_identity"]
      },
      "billing": {
        "unit": "verification-attempt",
        "billableOutcomes": ["COMPLETED", "REJECTED"],
        "commissionRate": 0.25
      }
    }
  }
}