{
  "version": "1.2.0",
  "platform": {
    "commissionRate": 0.2,
    "minimumFee": 10,
    "currency": "USD"
  },
  "contracts": {
    "claim-v1": {
      "entryAgent": "olang-kernel",
      "orchestrator": "olang-kernel",
      "requiredCapabilities": ["read_claim", "fraud_check", "submit_claim", "flag_for_review"],
      "prohibited": [],
      "agents": {
        "olang-kernel": {
          "capabilities": ["read_claim", "fraud_check", "submit_claim", "flag_for_review", "kernel_anchor"],
          "mayDelegateTo": {
            "python-claim-processor": ["read_claim", "submit_claim", "flag_for_review"],
            "node-fraud-checker": ["fraud_check"]
          }
        },
        "python-claim-processor": {
          "capabilities": ["read_claim", "submit_claim", "flag_for_review"],
          "mayDelegateTo": {}
        },
        "node-fraud-checker": {
          "capabilities": ["fraud_check"],
          "mayDelegateTo": {}
        }
      },
      "preconditions": {
        "submit_claim": {
          "requiresStep": ["fraud_check"],
          "denyIf": { "fraud": true }
        },
        "flag_for_review": {
          "requiresStep": ["fraud_check"],
          "denyIf": { "fraud": false }
        }
      },
      "outcomes": {
        "COMPLETED": ["read_claim", "fraud_check", "submit_claim"],
        "HELD_FOR_REVIEW": ["read_claim", "fraud_check", "flag_for_review"]
      },
      "billing": {
        "unit": "claim-delegated",
        "unitPrice": 500,
        "billableOutcomes": ["COMPLETED"],
        "commissionRate": 0.2
      }
    }
  }
}
